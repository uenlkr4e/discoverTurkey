# Copy to .env for local builds. In Cloudflare Pages set these per environment (Production / Preview).
SITE_URL=https://www.example.com
# "preview" renders drafts with a banner and blocks crawlers. Leave unset in production.
PUBLIC_ENV=
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_AD_SLOT_INCONTENT=
PUBLIC_AD_SLOT_SIDEBAR=
PUBLIC_AD_SLOT_FOOTER=
# strict (default) or regional; see docs/ads-and-consent.md before changing.
PUBLIC_CONSENT_MODE=strict
PUBLIC_GA4_ID=
