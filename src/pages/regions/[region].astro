---
import type { CollectionEntry } from 'astro:content';
import Card from '../../components/Card.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { taxonomyText, type Destination, type Itinerary } from '../../lib/collections';
import { regionPaths } from '../../lib/routes';
import { pageTitle } from '../../lib/seo';
import { hrefFor, regionHref } from '../../lib/urls';

export const getStaticPaths = () => regionPaths();

interface Props {
  region: CollectionEntry<'regions'>;
  destinations: Destination[];
  itineraries: Itinerary[];
}

const { region, destinations, itineraries } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { name, description } = taxonomyText(region, locale);
const title = t('region.title', { region: name });
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('regions.title'), href: localizePath('/regions/', locale) },
  { name, href: regionHref(region.id, locale) },
];
---

<BaseLayout title={pageTitle(t('region.pageTitle', { region: name }))} description={description} crumbs={crumbs}>
  <div class="container">
    <PageIntro title={title} lede={description} />
    <section class="section" aria-labelledby="destinations">
      <h2 id="destinations">{t('common.destinations')}</h2>
      <ul class="card-grid">
        {
          destinations.map((d) => (
            <li>
              <Card href={hrefFor(d)} title={d.data.title} summary={d.data.summary} image={d.data.heroImage.src} />
            </li>
          ))
        }
      </ul>
    </section>

    {
      itineraries.length > 0 && (
        <section class="section" aria-labelledby="itineraries">
          <h2 id="itineraries">{t('region.itineraries')}</h2>
          <ul class="card-grid">
            {itineraries.map((it) => (
              <li>
                <Card
                  href={hrefFor(it)}
                  title={it.data.title}
                  summary={it.data.summary}
                  image={it.data.heroImage.src}
                  eyebrow={t.plural('common.days', it.data.days)}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
