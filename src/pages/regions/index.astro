---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { getDestinations, getRegionsWithContent, taxonomyText } from '../../lib/collections';
import { pageTitle } from '../../lib/seo';
import { regionHref } from '../../lib/urls';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const [regions, destinations] = await Promise.all([getRegionsWithContent(locale), getDestinations(locale)]);
const countIn = (id: string) => destinations.filter((d) => d.data.region.id === id).length;
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('regions.title'), href: localizePath('/regions/', locale) },
];
---

<BaseLayout
  title={pageTitle(t('regions.title'))}
  description={t('regions.description')}
  crumbs={crumbs}
  noindex={regions.length === 0}
>
  <div class="container">
    <PageIntro title={t('regions.title')} lede={t('regions.lede')} />
    <ul class="regions">
      {
        regions.map((r) => (
          <li>
            <h2>
              <a href={regionHref(r.id, locale)}>{taxonomyText(r, locale).name}</a>
            </h2>
            <p>{taxonomyText(r, locale).description}</p>
            <p class="eyebrow">{t.plural('regions.count', countIn(r.id))}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .regions {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .regions li {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .regions h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.4rem;
  }
</style>
