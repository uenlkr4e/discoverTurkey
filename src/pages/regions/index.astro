---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDestinations, getRegionsWithContent } from '../../lib/collections';
import { pageTitle } from '../../lib/seo';
import { regionHref } from '../../lib/urls';

const [regions, destinations] = await Promise.all([getRegionsWithContent(), getDestinations()]);
const countIn = (id: string) => destinations.filter((d) => d.data.region.id === id).length;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Regions', href: '/regions/' },
];
---

<BaseLayout
  title={pageTitle('Regions of Turkey')}
  description="Explore Turkey region by region, from Istanbul and the Marmara to the Aegean, the Mediterranean and Central Anatolia."
  crumbs={crumbs}
  noindex={regions.length === 0}
>
  <div class="container">
    <PageIntro title="Regions of Turkey" lede="Turkey is traditionally divided into seven geographical regions." />
    <ul class="regions">
      {
        regions.map((r) => (
          <li>
            <h2>
              <a href={regionHref(r.id)}>{r.data.name}</a>
            </h2>
            <p>{r.data.description}</p>
            <p class="eyebrow">
              {countIn(r.id)} destination{countIn(r.id) === 1 ? '' : 's'}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .regions {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .regions li {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .regions h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.4rem;
  }
</style>
