---
import { render, type CollectionEntry } from 'astro:content';
import DraftBanner from '../components/DraftBanner.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeOf, localizePath } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { isPublished } from '../lib/content';
import { formatDate, isoDate } from '../lib/format';
import { pagePaths } from '../lib/routes';
import { pageTitle } from '../lib/seo';

export const getStaticPaths = () => pagePaths();

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const locale = localeOf(entry.id);
const t = useTranslations(locale);
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: d.title, href: Astro.url.pathname },
];
---

<BaseLayout title={pageTitle(d.title)} description={d.summary} crumbs={crumbs} noindex={!isPublished(d)}>
  {!isPublished(d) && <DraftBanner slot="banner" status={d.status} />}
  <div class="container">
    <PageIntro title={d.title}>
      <p class="updated">
        {t('page.updated')} <time datetime={isoDate(d.updatedAt)}>{formatDate(d.updatedAt, locale)}</time>
      </p>
    </PageIntro>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .updated {
    color: var(--muted);
  }
</style>
