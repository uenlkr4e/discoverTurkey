---
import type { CollectionEntry } from 'astro:content';
import Card from '../../../components/Card.astro';
import PageIntro from '../../../components/PageIntro.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';
import { taxonomyText, type Guide } from '../../../lib/collections';
import { guideCategoryPaths } from '../../../lib/routes';
import { pageTitle } from '../../../lib/seo';
import { guideCategoryHref, hrefFor } from '../../../lib/urls';

export const getStaticPaths = () => guideCategoryPaths();

interface Props {
  category: CollectionEntry<'guideCategories'>;
  guides: Guide[];
}

const { category, guides } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { name, description } = taxonomyText(category, locale);
const title = t('guides.categoryTitle', { category: name });
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.guides'), href: localizePath('/guides/', locale) },
  { name, href: guideCategoryHref(category.id, locale) },
];
---

<BaseLayout title={pageTitle(title)} description={description} crumbs={crumbs}>
  <div class="container">
    <PageIntro title={title} lede={description} />
    <ul class="card-grid">
      {
        guides.map((g) => (
          <li>
            <Card href={hrefFor(g)} title={g.data.title} summary={g.data.summary} image={g.data.heroImage.src} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
