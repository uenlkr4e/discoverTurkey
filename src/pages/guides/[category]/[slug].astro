---
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { localeOf, localizePath } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';
import { resolve, taxonomyText, type Guide } from '../../../lib/collections';
import { guidePaths } from '../../../lib/routes';
import { guideCategoryHref } from '../../../lib/urls';

export const getStaticPaths = () => guidePaths();

interface Props {
  entry: Guide;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = localeOf(entry.id);
const t = useTranslations(locale);
const categoryEntry = await resolve(entry.data.category);
const category = { id: categoryEntry.id, name: taxonomyText(categoryEntry, locale).name };
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.guides'), href: localizePath('/guides/', locale) },
  { name: category.name, href: guideCategoryHref(category.id, locale) },
  { name: entry.data.title, href: Astro.url.pathname },
];
---

<ArticleLayout
  entry={entry}
  eyebrow={t('guide.eyebrow', { category: category.name })}
  crumbs={crumbs}
  filters={{ category: [category.name] }}
>
  <p class="notice">{t('guide.notice')}</p>
  <div class="prose body">
    <Content />
  </div>
</ArticleLayout>

<style>
  .body {
    margin-top: var(--space-4);
  }
</style>
