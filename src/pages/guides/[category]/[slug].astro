---
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getGuides, resolve, type Guide } from '../../../lib/collections';
import { guideCategoryHref } from '../../../lib/urls';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((entry) => ({
    params: { category: entry.data.category.id, slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Guide;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = await resolve(entry.data.category);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Travel tips', href: '/guides/' },
  { name: category.data.name, href: guideCategoryHref(category.id) },
  { name: entry.data.title, href: Astro.url.pathname },
];
---

<ArticleLayout
  entry={entry}
  eyebrow={`Travel tips · ${category.data.name}`}
  crumbs={crumbs}
  filters={{ category: [category.data.name] }}
>
  <p class="notice">
    Prices, opening hours, fares and entry rules change. Check the official sources linked in this guide before you
    travel.
  </p>
  <div class="prose body">
    <Content />
  </div>
</ArticleLayout>

<style>
  .body {
    margin-top: var(--space-4);
  }
</style>
