---
import Card from '../../components/Card.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { getGuideCategoriesWithContent, getGuides, taxonomyText } from '../../lib/collections';
import { pageTitle } from '../../lib/seo';
import { guideCategoryHref, hrefFor } from '../../lib/urls';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const [categories, guides] = await Promise.all([getGuideCategoriesWithContent(locale), getGuides(locale)]);
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.guides'), href: localizePath('/guides/', locale) },
];
---

<BaseLayout
  title={pageTitle(t('guides.title'))}
  description={t('guides.description')}
  crumbs={crumbs}
  noindex={categories.length === 0}
>
  <div class="container">
    <PageIntro title={t('guides.heading')} lede={t('guides.lede')} />
    {categories.length === 0 && <p>{t('guides.empty')}</p>}
    {
      categories.map((category) => (
        <section class="section" aria-labelledby={`cat-${category.id}`}>
          <h2 id={`cat-${category.id}`}>
            <a href={guideCategoryHref(category.id, locale)}>{taxonomyText(category, locale).name}</a>
          </h2>
          <ul class="card-grid">
            {guides
              .filter((g) => g.data.category.id === category.id)
              .map((g) => (
                <li>
                  <Card href={hrefFor(g)} title={g.data.title} summary={g.data.summary} image={g.data.heroImage.src} />
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
