---
import { render } from 'astro:content';
import FactBox from '../../components/FactBox.astro';
import MapLinks from '../../components/MapLinks.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { localeOf, localizePath } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { resolve, taxonomyText, type Destination } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';
import { destinationPaths } from '../../lib/routes';
import { SEASONS } from '../../lib/season';
import { absoluteUrl, touristDestinationLd } from '../../lib/seo';
import { interestHref, regionHref } from '../../lib/urls';

export const getStaticPaths = () => destinationPaths();

interface Props {
  entry: Destination;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const locale = localeOf(entry.id);
const t = useTranslations(locale);
const [regionEntry, interestEntries] = await Promise.all([resolve(d.region), Promise.all(d.interests.map(resolve))]);
const region = { id: regionEntry.id, name: taxonomyText(regionEntry, locale).name };
const interests = interestEntries.map((i) => ({ id: i.id, name: taxonomyText(i, locale).name }));

const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.destinations'), href: localizePath('/destinations/', locale) },
  { name: d.title, href: Astro.url.pathname },
];
const place = touristDestinationLd({
  name: d.title,
  description: d.seoDescription ?? d.summary,
  url: absoluteUrl(Astro.url.pathname, Astro.site!),
  lat: d.coordinates.lat,
  lng: d.coordinates.lng,
});
---

<ArticleLayout
  entry={entry}
  eyebrow={t('destination.eyebrow', { region: region.name })}
  crumbs={crumbs}
  jsonLd={[place]}
  filters={{ region: [region.name], interest: interests.map((i) => i.name) }}
>
  <FactBox
    facts={[
      { label: t('destination.region'), value: region.name, href: regionHref(region.id, locale) },
      { label: t('destination.bestTime'), value: d.bestTimeToVisit.summary },
      { label: t('destination.stay'), value: d.suggestedDuration },
    ]}
  />

  <div class="prose">
    <Content />
  </div>

  <section aria-labelledby="best-time">
    <h2 id="best-time">{t('destination.bestTime')}</h2>
    <p class="prose">{d.bestTimeToVisit.summary}</p>
    <dl class="seasons">
      {
        SEASONS.map((season) => (
          <div>
            <dt>{t(`season.${season}`)}</dt>
            <dd>{d.bestTimeToVisit[season]}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="attractions">
    <h2 id="attractions">{t('destination.attractions')}</h2>
    {
      d.attractions.map((attraction) => (
        <>
          <h3>{attraction.name}</h3>
          <div class="prose" set:html={renderMarkdown(attraction.description)} />
        </>
      ))
    }
  </section>

  <section aria-labelledby="getting-there">
    <h2 id="getting-there">{t('destination.gettingThere')}</h2>
    <div class="prose" set:html={renderMarkdown(d.gettingThere)} />
  </section>

  <section aria-labelledby="getting-around">
    <h2 id="getting-around">{t('destination.gettingAround')}</h2>
    <div class="prose" set:html={renderMarkdown(d.gettingAround)} />
  </section>

  <section aria-labelledby="food">
    <h2 id="food">{t('destination.food')}</h2>
    <div class="prose" set:html={renderMarkdown(d.foodAndExperiences)} />
  </section>

  <section aria-labelledby="map">
    <h2 id="map">{t('destination.map')}</h2>
    <MapLinks name={d.title} lat={d.coordinates.lat} lng={d.coordinates.lng} />
  </section>

  <section aria-labelledby="good-for">
    <h2 id="good-for">{t('common.goodFor')}</h2>
    <ul class="chip-list">
      {interests.map((i) => <li><a href={interestHref(i.id, locale)}>{i.name}</a></li>)}
    </ul>
  </section>
</ArticleLayout>

<style>
  .seasons {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: var(--space-4) 0 0;
  }

  .seasons div {
    --season: var(--olive);
    padding: var(--space-4) var(--space-4) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--season);
    border-radius: 6px 6px var(--radius) var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .seasons div:nth-child(2) {
    --season: var(--saffron);
  }

  .seasons div:nth-child(3) {
    --season: var(--terracotta);
  }

  .seasons div:nth-child(4) {
    --season: var(--cobalt);
  }

  dt {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.25rem;
  }

  dd {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }
</style>
