---
import Card from '../../components/Card.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { getDestinations, getInterestsWithContent, getRegionsWithContent, taxonomyText } from '../../lib/collections';
import { pageTitle } from '../../lib/seo';
import { hrefFor, interestHref, regionHref } from '../../lib/urls';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const [destinations, regions, interests] = await Promise.all([
  getDestinations(locale),
  getRegionsWithContent(locale),
  getInterestsWithContent(locale),
]);
const regionNames = new Map(regions.map((r) => [r.id, taxonomyText(r, locale).name]));
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.destinations'), href: localizePath('/destinations/', locale) },
];
---

<BaseLayout
  title={pageTitle(t('destinations.title'))}
  description={t('destinations.description')}
  crumbs={crumbs}
  noindex={destinations.length === 0}
>
  <div class="container">
    <PageIntro title={t('destinations.title')} lede={t('destinations.lede')} />

    {
      regions.length > 0 && (
        <section class="section" aria-labelledby="by-region">
          <h2 id="by-region">{t('common.browseByRegion')}</h2>
          <ul class="chip-list">
            {regions.map((r) => <li><a href={regionHref(r.id, locale)}>{regionNames.get(r.id)}</a></li>)}
          </ul>
        </section>
      )
    }

    {
      interests.length > 0 && (
        <section class="section" aria-labelledby="by-interest">
          <h2 id="by-interest">{t('common.browseByInterest')}</h2>
          <ul class="chip-list">
            {interests.map((i) => <li><a href={interestHref(i.id, locale)}>{taxonomyText(i, locale).name}</a></li>)}
          </ul>
        </section>
      )
    }

    <section class="section" aria-labelledby="all-destinations">
      <h2 id="all-destinations">{t('destinations.all')}</h2>
      {
        destinations.length > 0 ? (
          <ul class="card-grid">
            {destinations.map((d) => (
              <li>
                <Card
                  href={hrefFor(d)}
                  title={d.data.title}
                  summary={d.data.summary}
                  image={d.data.heroImage.src}
                  eyebrow={regionNames.get(d.data.region.id)}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p>{t('destinations.empty')}</p>
        )
      }
    </section>
  </div>
</BaseLayout>
