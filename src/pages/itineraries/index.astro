---
import Card from '../../components/Card.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { getItineraries } from '../../lib/collections';
import { pageTitle } from '../../lib/seo';
import { hrefFor } from '../../lib/urls';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const itineraries = await getItineraries(locale);
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.itineraries'), href: localizePath('/itineraries/', locale) },
];
---

<BaseLayout
  title={pageTitle(t('itineraries.title'))}
  description={t('itineraries.description')}
  crumbs={crumbs}
  noindex={itineraries.length === 0}
>
  <div class="container">
    <PageIntro title={t('itineraries.heading')} lede={t('itineraries.lede')} />
    {
      itineraries.length > 0 ? (
        <ul class="card-grid">
          {itineraries.map((it) => (
            <li>
              <Card
                href={hrefFor(it)}
                title={it.data.title}
                summary={it.data.summary}
                image={it.data.heroImage.src}
                eyebrow={t.plural('common.days', it.data.days)}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p>{t('itineraries.empty')}</p>
      )
    }
  </div>
</BaseLayout>
