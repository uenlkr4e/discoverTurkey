---
import { render } from 'astro:content';
import FactBox from '../../components/FactBox.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { idIn, localeOf, localizePath } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { getDestinations, resolve, taxonomyText, type Itinerary } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';
import { itineraryPaths } from '../../lib/routes';
import { hrefFor, interestHref } from '../../lib/urls';

export const getStaticPaths = () => itineraryPaths();

interface Props {
  entry: Itinerary;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const locale = localeOf(entry.id);
const t = useTranslations(locale);
const [interestEntries, visible] = await Promise.all([Promise.all(d.interests.map(resolve)), getDestinations(locale)]);
const interests = interestEntries.map((i) => ({ id: i.id, name: taxonomyText(i, locale).name }));
// Only link stops to destinations that are actually built, in this itinerary's language.
const visibleById = new Map(visible.map((dest) => [dest.id, dest]));
const stops = [...d.stops].sort((a, b) => a.day - b.day).map((stop) => ({
  ...stop,
  destination: visibleById.get(idIn(stop.destination.id, locale)),
}));
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.itineraries'), href: localizePath('/itineraries/', locale) },
  { name: d.title, href: Astro.url.pathname },
];
---

<ArticleLayout
  entry={entry}
  eyebrow={t('itinerary.eyebrow', { count: d.days })}
  crumbs={crumbs}
  filters={{ interest: interests.map((i) => i.name) }}
>
  <FactBox
    facts={[
      { label: t('itinerary.length'), value: t.plural('common.days', d.days) },
      { label: t('common.goodFor'), value: interests.map((i) => i.name).join(', ') },
    ]}
  />

  <div class="prose">
    <Content />
  </div>

  <section aria-labelledby="day-by-day">
    <h2 id="day-by-day">{t('itinerary.dayByDay')}</h2>
    <ol class="stops">
      {
        stops.map((stop) => (
          <li>
            <h3>{t('itinerary.day', { day: stop.day, title: stop.title })}</h3>
            <div class="prose" set:html={renderMarkdown(stop.plan)} />
            {stop.destination && (
              <p>
                <a href={hrefFor(stop.destination)}>{t('itinerary.readGuide', { title: stop.destination.data.title })}</a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="good-for">
    <h2 id="good-for">{t('common.goodFor')}</h2>
    <ul class="chip-list">
      {interests.map((i) => <li><a href={interestHref(i.id, locale)}>{i.name}</a></li>)}
    </ul>
  </section>
</ArticleLayout>

<style>
  /* A route line with a star at each stop. */
  .stops {
    position: relative;
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .stops li {
    position: relative;
    padding: 0 0 var(--space-2) var(--space-6);
  }

  .stops li::before {
    content: '';
    position: absolute;
    left: calc(0.875rem - 1px);
    top: 1.5rem;
    bottom: -1.5rem;
    border-left: 2px dashed var(--line);
  }

  .stops li:last-child::before {
    display: none;
  }

  .stops li::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--terracotta);
    mask: var(--star) center / contain no-repeat;
  }

  .stops li:nth-child(even)::after {
    background: var(--cobalt);
  }

  .stops li + li {
    margin-top: var(--space-4);
  }

  .stops h3 {
    margin-top: 0;
  }
</style>
