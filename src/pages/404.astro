---
import PageIntro from '../components/PageIntro.astro';
import SearchBox from '../components/SearchBox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { pageTitle } from '../lib/seo';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const local = (path: string) => localizePath(path, locale);
---

<BaseLayout title={pageTitle(t('notFound.title'))} description={t('notFound.description')} noindex>
  <div class="container">
    <PageIntro title={t('notFound.title')} lede={t('notFound.lede')} />
    <SearchBox id="notfound-search" />
    <ul class="chip-list links">
      <li><a href={local('/')}>{t('nav.home')}</a></li>
      <li><a href={local('/destinations/')}>{t('nav.destinations')}</a></li>
      <li><a href={local('/guides/')}>{t('nav.guides')}</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .links {
    margin-top: var(--space-5);
  }
</style>
