---
import type { CollectionEntry } from 'astro:content';
import Card from '../../components/Card.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, toLocale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/ui';
import { taxonomyText, type Destination, type Itinerary } from '../../lib/collections';
import { interestPaths } from '../../lib/routes';
import { pageTitle } from '../../lib/seo';
import { hrefFor, interestHref } from '../../lib/urls';

export const getStaticPaths = () => interestPaths();

interface Props {
  interest: CollectionEntry<'interests'>;
  destinations: Destination[];
  itineraries: Itinerary[];
}

const { interest, destinations, itineraries } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { name, description } = taxonomyText(interest, locale);
const title = t('interest.title', { interest: name });
const crumbs = [
  { name: t('nav.home'), href: localizePath('/', locale) },
  { name: t('nav.interests'), href: localizePath('/interests/', locale) },
  { name, href: interestHref(interest.id, locale) },
];
---

<BaseLayout title={pageTitle(title)} description={description} crumbs={crumbs}>
  <div class="container">
    <PageIntro title={title} lede={description} />

    {
      destinations.length > 0 && (
        <section class="section" aria-labelledby="destinations">
          <h2 id="destinations">{t('common.destinations')}</h2>
          <ul class="card-grid">
            {destinations.map((d) => (
              <li>
                <Card href={hrefFor(d)} title={d.data.title} summary={d.data.summary} image={d.data.heroImage.src} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      itineraries.length > 0 && (
        <section class="section" aria-labelledby="itineraries">
          <h2 id="itineraries">{t('common.itineraries')}</h2>
          <ul class="card-grid">
            {itineraries.map((it) => (
              <li>
                <Card
                  href={hrefFor(it)}
                  title={it.data.title}
                  summary={it.data.summary}
                  image={it.data.heroImage.src}
                  eyebrow={t.plural('common.days', it.data.days)}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
