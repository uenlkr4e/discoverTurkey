---
import { FOOTER_LINKS, NAV, SITE } from '../config/site';
import { localizePath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { getBuiltPaths } from '../lib/collections';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const built = await getBuiltPaths();
// Translated pages where they exist, otherwise the English ones.
const local = (path: string) => (built.has(localizePath(path, locale)) ? localizePath(path, locale) : path);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="brand">{SITE.name}</p>
      <p class="muted">{t('site.description')}</p>
    </div>
    <nav aria-label={t('footer.explore')}>
      <ul>{NAV.map((item) => <li><a href={local(item.href)}>{t(item.key)}</a></li>)}</ul>
    </nav>
    <nav aria-label={t('footer.aboutSite')}>
      <ul>
        {FOOTER_LINKS.map((item) => <li><a href={local(item.href)}>{t(item.key)}</a></li>)}
        <slot />
      </ul>
    </nav>
  </div>
  <p class="container muted copy">© {year} {SITE.name}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-6) var(--space-4);
    background: var(--tile-dark) 0 0 / 56px 56px, var(--cobalt-deep);
    color: #f3e7d3;
    border-top: 4px solid var(--saffron);
    --focus: var(--saffron);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 var(--space-3);
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 400;
    color: #fffbf4;
  }

  .brand::before {
    content: '';
    width: 1.3rem;
    height: 1.3rem;
    background: var(--saffron);
    mask: var(--star) center / contain no-repeat;
  }

  .muted {
    color: #c9bba6;
    max-width: 40ch;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* The privacy-settings button keeps its own display so its [hidden] state still applies. */
  a,
  ul :global(button) {
    color: #f3e7d3;
    text-decoration-color: rgb(226 164 43 / 50%);
  }

  a:hover,
  ul :global(button:hover) {
    color: var(--saffron);
    text-decoration-color: var(--saffron);
  }

  .copy {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(243 231 211 / 18%);
    font-size: 0.9rem;
    max-width: none;
  }
</style>
