---
import { FOOTER_LINKS, NAV, SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="brand">{SITE.name}</p>
      <p class="muted">{SITE.description}</p>
    </div>
    <nav aria-label="Explore">
      <ul>{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="About this site">
      <ul>
        {FOOTER_LINKS.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <slot />
      </ul>
    </nav>
  </div>
  <p class="container muted copy">© {year} {SITE.name}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-5) var(--space-3);
    background: var(--sand);
    border-top: 1px solid var(--line);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .brand {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .muted {
    color: var(--muted);
    max-width: 40ch;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }

  .copy {
    margin-top: var(--space-4);
    font-size: 0.9rem;
  }
</style>
