---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-intro">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-intro {
    position: relative;
    margin-block: var(--space-5) var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .page-intro::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 14px;
    height: 14px;
    background: var(--terracotta);
    mask: var(--star) center / contain no-repeat;
  }

  .page-intro :global(.lede) {
    margin-bottom: 0;
  }
</style>
