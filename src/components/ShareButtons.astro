---
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  url: string;
  contentType: string;
  /** Absolute URL of the page's Pinterest image; adds a Pinterest button when present. */
  pinMedia?: string;
}

const { title, url, contentType, pinMedia } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
const text = encodeURIComponent(title);
const link = encodeURIComponent(url);
const networks = [
  { method: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${text}%20${link}` },
  { method: 'x', label: 'X', href: `https://x.com/intent/tweet?text=${text}&url=${link}` },
  { method: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${link}` },
  ...(pinMedia
    ? [
        {
          method: 'pinterest',
          label: 'Pinterest',
          href: `https://www.pinterest.com/pin/create/button/?url=${link}&media=${encodeURIComponent(pinMedia)}&description=${text}`,
        },
      ]
    : []),
];
---

<section
  class="share"
  aria-labelledby="share-heading"
  data-share
  data-title={title}
  data-url={url}
  data-content-type={contentType}
  data-copied={t('share.copied')}
  data-copy-failed={t('share.copyFailed')}
  data-pagefind-ignore
>
  <h2 id="share-heading" class="share-heading">{t('share.heading')}</h2>
  <ul class="chip-list">
    <li><button type="button" class="chip" data-share-native hidden>{t('share.native')}</button></li>
    <li><button type="button" class="chip" data-share-copy>{t('share.copy')}</button></li>
    {
      networks.map((n) => (
        <li>
          <a href={n.href} target="_blank" rel="noopener" data-share-method={n.method}>
            {n.label}
            <span class="visually-hidden">{t('common.newTab')}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="share-status" data-share-status role="status"></p>
</section>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-block: var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }

  .share-heading {
    margin: 0;
    font-size: 1.25rem;
  }

  .share-status {
    flex-basis: 100%;
    min-height: 1.6em;
    margin: 0;
    color: var(--muted);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .chip:hover {
    border-color: var(--cobalt);
    background: var(--cobalt);
    color: var(--surface);
  }
</style>
