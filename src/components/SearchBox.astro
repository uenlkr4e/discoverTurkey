---
interface Props {
  id: string;
  label?: string;
}

const { id, label = 'Search destinations and guides' } = Astro.props;
---

<form class="search-box" role="search" action="/search/" method="get">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name="q" type="search" autocomplete="off" required />
    <button class="button" type="submit">Search</button>
  </div>
</form>

<style>
  label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .row {
    display: flex;
    gap: var(--space-2);
    max-width: 36rem;
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--muted);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
</style>
