---
interface Props {
  id: string;
  label?: string;
}

const { id, label = 'Search destinations and guides' } = Astro.props;
---

<form class="search-box" role="search" action="/search/" method="get">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name="q" type="search" autocomplete="off" required />
    <button class="button" type="submit">Search</button>
  </div>
</form>

<style>
  label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .row {
    display: flex;
    gap: var(--space-1);
    max-width: 36rem;
    padding: 0.3rem;
    border: 1px solid var(--muted);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .row:focus-within {
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px rgb(28 61 110 / 18%);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
  }

  input:focus-visible {
    outline-offset: 0;
  }
</style>
