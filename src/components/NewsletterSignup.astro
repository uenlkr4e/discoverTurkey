---
import { localizePath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { getBuiltPaths } from '../lib/collections';
import { newsletter } from '../lib/site-env';

interface Props {
  /** Where the form is shown, reported to analytics. */
  placement: 'article' | 'home';
}

const { placement } = Astro.props;
const id = `newsletter-${placement}`;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const privacyPath = localizePath('/privacy/', locale);
const privacy = (await getBuiltPaths()).has(privacyPath) ? privacyPath : '/privacy/';
---

{
  newsletter && (
    <section class="newsletter" aria-labelledby={`${id}-heading`} data-pagefind-ignore="all">
      <h2 id={`${id}-heading`}>{t('newsletter.heading')}</h2>
      <p>{t('newsletter.body')}</p>
      <form
        method="post"
        action={newsletter.action}
        target="_blank"
        data-newsletter={placement}
        class="newsletter-form"
      >
        <label for={`${id}-email`}>{t('newsletter.label')}</label>
        <div class="newsletter-row">
          <input
            id={`${id}-email`}
            type="email"
            name={newsletter.emailField}
            autocomplete="email"
            required
          />
          <button type="submit">
            {t('newsletter.submit')}
            <span class="visually-hidden">{t('common.newTab')}</span>
          </button>
        </div>
      </form>
      <p class="newsletter-note">
        {t('newsletter.note', { provider: newsletter.provider })} <a href={privacy}>{t('newsletter.privacy')}</a>
      </p>
    </section>
  )
}

<style>
  .newsletter {
    margin-block: var(--space-6);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--saffron);
    border-radius: 6px 6px var(--radius) var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .newsletter h2 {
    margin-top: 0;
  }

  .newsletter-form label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .newsletter-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .newsletter-row input {
    flex: 1 1 16rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--muted);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  .newsletter-row button {
    min-height: 44px;
    padding: 0 1.4rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--cobalt);
    color: var(--surface);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .newsletter-row button:hover {
    background: var(--cobalt-deep);
  }

  .newsletter-note {
    margin: var(--space-3) 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
