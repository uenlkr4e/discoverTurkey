---
import { Image } from 'astro:assets';
import type { HeroImage } from '../lib/collections';

interface Props {
  image: HeroImage;
}

const { image } = Astro.props;
---

<figure class="hero">
  <Image
    src={image.src}
    alt={image.alt}
    widths={[640, 960, 1280, 1600]}
    sizes="(min-width: 1152px) 72rem, 100vw"
    priority
    class="hero-img"
  />
  <figcaption>
    Photo: <a href={image.credit.sourceUrl} rel="noopener">{image.credit.author}</a>, {image.credit.license}
  </figcaption>
</figure>

<style>
  .hero {
    margin: 0 0 var(--space-5);
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--sand);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--muted);
  }

  figcaption a {
    color: var(--muted);
  }
</style>
