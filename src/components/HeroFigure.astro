---
import { Image } from 'astro:assets';
import type { HeroImage } from '../lib/collections';

interface Props {
  image: HeroImage;
}

const { image } = Astro.props;
---

<figure class="hero">
  <Image
    src={image.src}
    alt={image.alt}
    widths={[640, 960, 1280, 1600]}
    sizes="(min-width: 1152px) 72rem, 100vw"
    priority
    class="hero-img"
  />
  <figcaption>
    Photo: <a href={image.credit.sourceUrl} rel="noopener">{image.credit.author}</a>, {image.credit.license}
  </figcaption>
</figure>

<style>
  .hero {
    position: relative;
    margin: 0 0 var(--space-6);
  }

  /* Offset saffron frame behind the photo. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0.9rem -0.9rem auto 0.9rem;
    aspect-ratio: 16 / 9;
    border: 2px solid var(--saffron);
    border-radius: var(--radius-lg);
    pointer-events: none;
  }

  .hero-img {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--paper-deep);
    box-shadow: var(--shadow-md);
  }

  figcaption {
    margin-top: var(--space-4);
    font-size: 0.85rem;
    color: var(--muted);
  }

  figcaption a {
    color: var(--muted);
  }

  @media (max-width: 639px) {
    .hero::before {
      display: none;
    }

    figcaption {
      margin-top: var(--space-2);
    }
  }
</style>
