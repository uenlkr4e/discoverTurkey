---
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { adSlotHtml, type Placement } from '../lib/ads';
import { ads } from '../lib/site-env';

interface Props {
  placement: Placement;
}

const t = useTranslations(toLocale(Astro.currentLocale));
const html = adSlotHtml(Astro.props.placement, ads, t('common.advertisement'));
---

{html && <Fragment set:html={html} />}
