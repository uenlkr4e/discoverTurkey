---
import type { ArticleEntry } from '../lib/collections';
import { COLLECTION_LABEL, hrefFor } from '../lib/urls';
import Card from './Card.astro';

interface Props {
  items: ArticleEntry[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section" aria-labelledby="related-heading" data-pagefind-ignore>
      <h2 id="related-heading">Keep planning</h2>
      <ul class="card-grid">
        {items.map((item) => (
          <li>
            <Card
              href={hrefFor(item)}
              title={item.data.title}
              summary={item.data.summary}
              image={item.data.heroImage.src}
              eyebrow={COLLECTION_LABEL[item.collection]}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}
