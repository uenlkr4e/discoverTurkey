---
import type { ArticleEntry } from '../lib/collections';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { hrefFor } from '../lib/urls';
import Card from './Card.astro';

interface Props {
  items: ArticleEntry[];
}

const { items } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
---

{
  items.length > 0 && (
    <section class="section" aria-labelledby="related-heading" data-pagefind-ignore>
      <h2 id="related-heading">{t('related.heading')}</h2>
      <ul class="card-grid">
        {items.map((item) => (
          <li>
            <Card
              href={hrefFor(item)}
              title={item.data.title}
              summary={item.data.summary}
              image={item.data.heroImage.src}
              eyebrow={t(`type.${item.collection}`)}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}
