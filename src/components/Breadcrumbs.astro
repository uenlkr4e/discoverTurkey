---
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import type { Crumb } from '../lib/seo';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
---

<nav class="container breadcrumbs" aria-label={t('nav.breadcrumb')}>
  <ol>
    {
      crumbs.map((crumb, i) => (
        <li>
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.href}>{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }

  li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-left: var(--space-2);
    background: var(--saffron);
    mask: var(--star) center / contain no-repeat;
  }

  a,
  span {
    display: inline-block;
    padding-block: 0.4rem;
  }

  a {
    color: var(--muted);
    text-decoration-color: var(--line);
  }

  a:hover {
    color: var(--terracotta);
  }

  [aria-current='page'] {
    color: var(--ink);
  }
</style>
