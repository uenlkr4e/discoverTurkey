---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  summary: string;
  image?: ImageMetadata;
  eyebrow?: string;
  headingLevel?: 2 | 3;
}

const { href, title, summary, image, eyebrow, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  {
    image && (
      // Decorative: the linked title carries the meaning.
      <Image
        src={image}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 100vw"
        class="card-img"
      />
    )
  }
  <div class="card-body">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading class="card-title"><a href={href}>{title}</a></Heading>
    <p class="card-summary">{summary}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .card-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--sand);
  }

  .card-body {
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .card-title {
    margin: 0 0 var(--space-2);
    font-size: 1.25rem;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole card is clickable; the focus ring is drawn on the card instead. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card-summary {
    margin: 0;
    color: var(--muted);
  }
</style>
