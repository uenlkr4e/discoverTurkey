---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  summary: string;
  image?: ImageMetadata;
  eyebrow?: string;
  headingLevel?: 2 | 3;
}

const { href, title, summary, image, eyebrow, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  {
    image && (
      // Decorative: the linked title carries the meaning.
      <Image
        src={image}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 100vw"
        class="card-img"
      />
    )
  }
  <div class="card-body">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading class="card-title"><a href={href}>{title}</a></Heading>
    <p class="card-summary">{summary}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease),
      border-color 0.3s ease;
  }

  .card:hover {
    border-color: #cdb894;
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .card:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .card-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--paper-deep);
    transition: transform 0.6s var(--ease);
  }

  .card:hover .card-img {
    transform: scale(1.04);
  }

  /* Text-only cards (e.g. travel tips) get a tiled header band instead of a photo. */
  .card:not(:has(.card-img))::before {
    content: '';
    display: block;
    height: 0.6rem;
    background: linear-gradient(90deg, var(--accent), var(--cobalt));
  }

  .card-body {
    flex: 1;
    padding: var(--space-4) var(--space-4) var(--space-4);
    background: var(--surface);
  }

  .card-title {
    margin: 0 0 var(--space-2);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(var(--saffron), var(--saffron)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.35s var(--ease);
  }

  .card:hover .card-title a {
    color: var(--ink);
    background-size: 100% 2px;
  }

  /* Whole card is clickable; the focus ring is drawn on the card instead. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
