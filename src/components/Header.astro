---
import { NAV, SITE } from '../config/site';
import { LOCALES, localizePath, toLocale, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { getBuiltPaths } from '../lib/collections';

interface Props {
  /** Versions of this page in other languages. */
  alternates?: { locale: Locale; href: string }[];
}

const { alternates = [] } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const built = await getBuiltPaths();
// Link to this language's section when it exists, otherwise to the English one.
const local = (path: string) => (built.has(localizePath(path, locale)) ? localizePath(path, locale) : path);
const path = Astro.url.pathname;
const items = [...NAV, { key: 'nav.search' as const, href: '/search/' }].map((item) => ({
  label: t(item.key),
  href: local(item.href),
}));
const languages = alternates.filter((a) => a.locale !== locale);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={local('/')}>{SITE.name}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{t('nav.menu')}</button>
    <nav id="site-nav" class="site-nav" aria-label={t('nav.main')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          languages.map((a) => (
            <li>
              <a
                class="lang-link"
                href={a.href}
                hreflang={LOCALES[a.locale].htmlLang}
                lang={LOCALES[a.locale].htmlLang}
                aria-label={useTranslations(a.locale)('nav.thisPageIn', { language: LOCALES[a.locale].name })}
              >
                {LOCALES[a.locale].name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 239 226 / 92%);
    border-bottom: 1px solid var(--line);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  /* A thin tile-coloured band along the very top of the page. */
  .site-header::before {
    content: '';
    display: block;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--cobalt) 0 25%,
      var(--accent) 25% 50%,
      var(--saffron) 50% 75%,
      var(--terracotta) 75% 100%
    );
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand::before {
    content: '';
    width: 1.35rem;
    height: 1.35rem;
    background: var(--terracotta);
    mask: var(--star) center / contain no-repeat;
    transition: transform 0.6s var(--ease);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand:hover::before {
    transform: rotate(90deg);
  }

  /* Without JavaScript the menu is always open and the toggle is hidden. */
  .menu-toggle {
    display: none;
    min-height: 44px;
    min-width: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .menu-toggle[aria-expanded='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  :global(.js) .menu-toggle {
    display: inline-flex;
    align-items: center;
  }

  .site-nav {
    width: 100%;
    padding-bottom: var(--space-3);
  }

  :global(.js) .site-nav {
    display: none;
  }

  :global(.js) .site-nav[data-open='true'] {
    display: block;
  }

  .site-nav ul {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 10px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    background: var(--paper-deep);
    color: var(--ink);
  }

  .site-nav a[aria-current='page'] {
    color: var(--terracotta);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  @media (min-width: 1024px) {
    :global(.js) .menu-toggle {
      display: none;
    }

    .site-nav,
    :global(.js) .site-nav {
      display: block;
      width: auto;
      padding: 0;
    }

    .site-nav ul {
      display: flex;
      gap: var(--space-1);
    }

    .site-nav a:hover {
      background: transparent;
      color: var(--terracotta);
    }
  }
</style>
