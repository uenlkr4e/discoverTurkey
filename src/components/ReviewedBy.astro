---
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  authorName: string;
  /** Link to the author's page; omitted while it isn't built. */
  authorHref?: string;
  reviewedBy?: string;
  reviewedAt?: Date;
}

const { authorName, authorHref, reviewedBy, reviewedAt } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<p class="byline">
  <span>{t('byline.by')} {authorHref ? <a href={authorHref} rel="author">{authorName}</a> : authorName}</span>
  <span aria-hidden="true">·</span>
  {
    reviewedBy && reviewedAt ? (
      <span>
        {t('byline.reviewed')} <time datetime={isoDate(reviewedAt)}>{formatDate(reviewedAt, locale)}</time>{' '}
        {t('byline.reviewedBy')} {reviewedBy}
      </span>
    ) : (
      <span>{t('byline.notReviewed')}</span>
    )
  }
</p>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    margin: 0 0 var(--space-5);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .byline > span:first-child {
    font-weight: 700;
    color: var(--ink);
  }
</style>
