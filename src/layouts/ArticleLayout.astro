---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import AdSlot from '../components/AdSlot.astro';
import DraftBanner from '../components/DraftBanner.astro';
import HeroFigure from '../components/HeroFigure.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ReviewedBy from '../components/ReviewedBy.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { adSlotHtml, insertInContentAd } from '../lib/ads';
import { pinPath } from '../lib/pins';
import { getRelatedFor, resolve, type ArticleEntry } from '../lib/collections';
import { isPublished } from '../lib/content';
import { absoluteUrl, articleLd, pageTitle, type Crumb } from '../lib/seo';
import { ads } from '../lib/site-env';
import { DEFAULT_LOCALE, localeOf } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { authorHref } from '../lib/urls';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: ArticleEntry;
  eyebrow: string;
  crumbs: Crumb[];
  /** Extra JSON-LD, e.g. TouristDestination; Article is added here. */
  jsonLd?: Record<string, unknown>[];
  /** Search filters for Pagefind, e.g. { region: ['Aegean'] }. */
  filters?: Record<string, string[]>;
}

const { entry, eyebrow, crumbs, jsonLd = [], filters = {} } = Astro.props;
const d = entry.data;
const locale = localeOf(entry.id);
const t = useTranslations(locale);
const [author, related] = await Promise.all([resolve(d.author), getRelatedFor(entry)]);
const description = d.seoDescription ?? d.summary;
const url = absoluteUrl(Astro.url.pathname, Astro.site!);
// Pin images are generated by `npm run pins` into public/; only use one that exists.
const pin = pinPath(entry.collection, entry.id);
const pinMedia = existsSync(join(process.cwd(), 'public', pin)) ? absoluteUrl(pin, Astro.site!) : undefined;
// Author pages exist only for published work, so drafts don't link to them.
const authorPath = isPublished(d) ? authorHref(author.id, locale) : undefined;
const type = t(`type.${entry.collection}`);
// Analytics reports content types in English whatever the page language.
const contentType = useTranslations(DEFAULT_LOCALE)(`type.${entry.collection}`).toLowerCase();
const article = articleLd({
  headline: d.title,
  description,
  url,
  author: {
    name: author.data.name,
    kind: author.data.kind,
    url: authorPath && absoluteUrl(authorPath, Astro.site!),
  },
  updatedAt: d.updatedAt,
  reviewedAt: d.reviewedAt,
  publishedAt: d.publishedAt,
});
const pagefindFilters = Object.entries({ type: [type], ...filters }).flatMap(([name, values]) =>
  values.map((value) => `${name}:${value}`),
);
const factsToVerify = entry.collection === 'guides' ? entry.data.factsToVerify : [];
// The in-content ad is placed in the rendered article column (see insertInContentAd).
const mainHtml = insertInContentAd(await Astro.slots.render('default'), adSlotHtml('incontent', ads, t('common.advertisement')));
---

<BaseLayout
  title={pageTitle(d.title, d.seoTitle)}
  description={description}
  crumbs={crumbs}
  image={d.heroImage.src}
  imageAlt={d.heroImage.alt}
  ogType="article"
  jsonLd={[article, ...jsonLd]}
  noindex={!isPublished(d)}
>
  {!isPublished(d) && <DraftBanner slot="banner" status={d.status} factsToVerify={factsToVerify} />}
  <article class="container article" data-pagefind-body>
    {pagefindFilters.map((f) => <span hidden data-pagefind-filter={f}></span>)}
    <span hidden data-pagefind-meta={`type:${type}`}></span>
    <header class="article-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <ReviewedBy authorName={author.data.name} authorHref={authorPath} reviewedBy={d.reviewedBy} reviewedAt={d.reviewedAt} />
    </header>
    <HeroFigure image={d.heroImage} pinMedia={pinMedia} pinDescription={d.summary} />
    <div class="article-grid">
      <div class="article-main" set:html={mainHtml} />
      {
        ads?.slots.sidebar && (
          <aside class="article-aside" aria-label={t('common.advertisement')} data-pagefind-ignore="all">
            <AdSlot placement="sidebar" />
          </aside>
        )
      }
    </div>
    <ShareButtons title={d.title} url={url} contentType={contentType} pinMedia={pinMedia} />
    {isPublished(d) && <NewsletterSignup placement="article" />}
    <RelatedContent items={related} />
    <AdSlot placement="footer" />
  </article>
</BaseLayout>

<style>
  .article-head {
    max-width: 52rem;
    margin-top: var(--space-5);
  }

  .article-head h1 {
    margin-bottom: var(--space-4);
  }

  .article-grid {
    display: grid;
    gap: var(--space-5);
  }

  /* The sidebar column exists only on wide screens. */
  .article-aside {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-grid:has(.article-aside) {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--space-6);
    }

    .article-aside {
      display: block;
    }
  }

  .article-main > :global(:first-child) {
    margin-top: 0;
  }

  /* Section headings in the article body get a small star marker. */
  .article-main :global(section > h2) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-6);
  }

  .article-main :global(section > h2)::before {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    background: var(--saffron);
    mask: var(--star) center / contain no-repeat;
  }
</style>
