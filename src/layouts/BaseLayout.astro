---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config/site';
import { showDrafts } from '../lib/collections';
import { assertContentValid } from '../lib/content-checks';
import { absoluteUrl, breadcrumbLd, jsonLdScript, type Crumb } from '../lib/seo';

interface Props {
  /** Full <title>, usually from pageTitle(). */
  title: string;
  description: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, crumbs = [], image, imageAlt, ogType = 'website', jsonLd = [], noindex = false } =
  Astro.props;

await assertContentValid();

const site = Astro.site!;
const canonical = absoluteUrl(Astro.url.pathname, site);
const og = image ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' }) : undefined;
const ogImage = og ? absoluteUrl(og.src, site) : undefined;
const structured = crumbs.length > 1 ? [...jsonLd, breadcrumbLd(crumbs, site)] : jsonLd;
const robots = noindex || showDrafts ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {structured.map((data) => <script type="application/ld+json" set:html={jsonLdScript(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot name="banner" />
    {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
